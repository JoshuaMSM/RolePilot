# Frontend: Supabase public connection values. Safe for the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only values for deployed daily careers discovery. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-or-secret-key
CRON_SECRET=generate-a-long-random-secret
